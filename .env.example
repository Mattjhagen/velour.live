# Development values only. Use long, unique secrets for any non-local setup.
# Copy this file to .env and replace every placeholder before running.

# Postgres
POSTGRES_DB=velour
POSTGRES_USER=velour
POSTGRES_PASSWORD=replace-me-with-a-long-random-value

# Redis
REDIS_PASSWORD=replace-me-with-a-different-long-random-value

# NextAuth — generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost
NEXTAUTH_SECRET=replace-me-32-chars-random

# GitHub OAuth App (github.com/settings/developers)
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me

# The single admin email allowed to sign in
VELOUR_ADMIN_EMAIL=replace-me@example.com

# Encryption key for stored environment variables — generate with: openssl rand -hex 32
VELOUR_ENCRYPTION_KEY=replace-me-64-hex-chars

# ── Container app settings ───────────────────────────────────────────────────
# Docker Compose prefixes network names with the project name.
# Run: docker network ls | grep ingress  to find yours (e.g. velour-live_ingress)
INGRESS_NETWORK=ingress

# Artifact and site storage paths (must match volume mounts in compose.yaml)
ARTIFACTS_PATH=/var/lib/velour/artifacts
SITES_PATH=/var/lib/velour/sites

# ── Production TLS (Caddyfile.prod only) ────────────────────────────────────
# Cloudflare API token with Zone:DNS:Edit scope for your domain
CLOUDFLARE_API_TOKEN=replace-me
VELOUR_ACME_EMAIL=replace-me@example.com
VELOUR_DOMAIN=velour.live

# Caddy Admin API URL (reachable from worker on the control-plane network)
CADDY_ADMIN_URL=http://caddy:2019

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Token from: one.dash.cloudflare.com → Zero Trust → Tunnels → Create a tunnel
CLOUDFLARE_TUNNEL_TOKEN=replace-me
