{
  on_demand_tls {
    # Only issue certs for slugs that exist as projects in the DB.
    # Prevents cert-farming for arbitrary subdomains.
    ask http://dashboard:3000/api/tls/verify
    interval 2m
    burst 5
  }
}

# Dashboard on main domain
velour.live, www.velour.live {
  reverse_proxy dashboard:3000
}

# Static sites — one cert issued on-demand per slug
*.velour.live {
  tls {
    on_demand
  }

  # {labels.0} is the leftmost label: "resume" in resume.velour.live
  root * /var/lib/velour/sites/{labels.0}

  file_server {
    hide .git
  }

  # SPA fallback: serve index.html for paths that don't match a file
  handle_errors 404 {
    rewrite * /index.html
    file_server
  }
}
