{
  # TLS is terminated at Cloudflare's edge — Caddy operates HTTP-only internally.
  auto_https off
}

# Main domain → dashboard
velour.live, www.velour.live {
  reverse_proxy dashboard:3000
}

# Slug subdomains → static site artifacts
# {labels.0} = "resume" in resume.velour.live
*.velour.live {
  root * /var/lib/velour/sites/{labels.0}

  file_server {
    hide .git
  }

  # SPA fallback: unknown paths serve index.html
  handle_errors 404 {
    rewrite * /index.html
    file_server
  }
}
