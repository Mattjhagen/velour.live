{
  # TLS is terminated at Cloudflare's edge — Caddy operates HTTP-only internally.
  auto_https off
  # Bind admin API on all interfaces so the worker can reach it from control-plane network.
  admin 0.0.0.0:2019
}

# Main domain → dashboard
http://velour.live, http://www.velour.live, http://velour.relayapp.pro {
  reverse_proxy dashboard:3000
}

# Slug subdomains → static site artifacts
# {labels.0} = "resume" in resume.velour.live
http://*.velour.live {
  root * /var/lib/velour/sites/{labels.0}

  file_server {
    hide .git
  }

  # SPA fallback: unknown paths serve index.html
  handle_errors 404 {
    rewrite * /index.html
    file_server
  }
}
